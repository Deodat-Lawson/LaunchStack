{
  "experiment": "production-replay: the segment brief in the buyers' language",
  "question": "On Norwegian company texts, does a Norwegian brief rank better than an English one with the app's two built-in embedding models?",
  "design": {
    "code": "src/distribution/semantic.ts (semanticRelevance), as production runs it; companies are checked from the top of that ranking down, as production does",
    "pools": "E4's three Norwegian register pools: the companies' texts are Norwegian",
    "briefs": {
      "english": "the segment as an English-writing seller types it",
      "norwegian": "E4's Norwegian brief: the same segment as a Norwegian seller would type it",
      "higher": "per company, the higher of its two relevance scores"
    },
    "check": "one check reveals one company's hidden label (its register code) and costs 1",
    "candidates": "a seed's 80% draw of the pool, in the order of its relevance to the brief",
    "metrics": {
      "found": "good companies among the first 25, 50, 100, 200 checks of today's fixed ranking",
      "zeroScoreRule": "whole pool: the share of companies, and of good companies, whose relevance is above zero, which is what production keeps before any fit check"
    },
    "embeddingModels": {
      "nomic-embed-text": "nomic-embed-text (local, the benchmark's model)",
      "gemini-embedding-001@768": "gemini-embedding-001 at 768 dimensions (index gemini-embedding-768, the one the registry recommends)",
      "text-embedding-3-large@1536": "text-embedding-3-large at 1536 dimensions (index legacy-openai-1536, the default)"
    },
    "intervals": "95% percentile bootstrap, 2,000 resamples: over pools and then seeds, as in E4"
  },
