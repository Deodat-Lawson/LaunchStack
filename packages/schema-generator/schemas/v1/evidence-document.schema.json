{
  "$ref": "#/definitions/evidence-document",
  "definitions": {
    "evidence-document": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object",
          "properties": {
            "filename": {
              "type": "string"
            },
            "mimeType": {
              "type": "string"
            },
            "pageCount": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pageNumber": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "text": {
                "type": "string"
              },
              "blocks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "heading",
                        "paragraph",
                        "list",
                        "table",
                        "figure",
                        "caption",
                        "code",
                        "header",
                        "footer",
                        "footnote",
                        "other"
                      ]
                    },
                    "text": {
                      "type": "string"
                    },
                    "bbox": {
                      "type": "object",
                      "properties": {
                        "x0": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "y0": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "x1": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "y1": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      },
                      "required": [
                        "x0",
                        "y0",
                        "x1",
                        "y1"
                      ],
                      "additionalProperties": false
                    },
                    "confidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "type",
                    "text"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "pageNumber",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "markdown": {
          "type": "string"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "schemaVersion",
        "provider",
        "source",
        "pages",
        "warnings"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
