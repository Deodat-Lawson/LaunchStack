# Line endings: LF in the repository AND in every working tree, on every OS.
#
# Git for Windows defaults to core.autocrlf=true, which checks text files out
# with CRLF. Shell scripts run inside Linux containers then fail
# (`/bin/sh^M: bad interpreter` — e.g. docker/seaweedfs-entrypoint.sh, mounted
# by docker-compose.yml), and Prettier (endOfLine: "lf") flags every file.
# `text=auto` leaves binaries alone; `eol=lf` overrides autocrlf for the rest.
* text=auto eol=lf

# Migration artifacts must never be auto-merged.
#
# Two PRs that each add a migration will both append an entry to _journal.json.
# A textual or union merge "succeeds" and produces duplicate `idx` values —
# silently broken. `-merge` forces git to raise a conflict instead, so the
# author notices and regenerates (see CONTRIBUTING.md).
packages/store/drizzle/meta/_journal.json    -merge
packages/store/drizzle/meta/*_snapshot.json  -merge
packages/store/drizzle/*.sql                 -merge
apps/web/drizzle/meta/_journal.json          -merge
apps/web/drizzle/meta/*_snapshot.json        -merge
apps/web/drizzle/*.sql                       -merge

# The snapshots are drizzle-kit's internal diff state — thousands of lines of
# machine-generated JSON, never hand-edited, and reviewing them line by line
# tells you nothing. Collapse them in diffs and keep them out of language
# stats so a one-table migration doesn't look like a 9,000-line PR. The
# reviewable artifact is the .sql file next to them.
packages/store/drizzle/meta/*_snapshot.json  linguist-generated=true
packages/store/drizzle/meta/_journal.json    linguist-generated=true
apps/web/drizzle/meta/*_snapshot.json        linguist-generated=true
apps/web/drizzle/meta/_journal.json          linguist-generated=true
