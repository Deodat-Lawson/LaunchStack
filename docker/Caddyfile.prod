# Production Caddyfile (mounted by docker-compose.prod.yml).
# Caddy provisions and renews Let's Encrypt certificates for both hosts.
# Optional: add a global `email you@example.com` block to receive certificate
# expiry notices from Let's Encrypt.

{$DOMAIN} {
	# The worker's /api/inngest is not routed: the self-hosted Inngest server
	# reaches it on the compose network. Only an Inngest Cloud setup needs a
	# public route (`handle /api/inngest* { reverse_proxy worker:8020 }`).
	handle {
		reverse_proxy app:3000
	}
}

# Object storage: SeaweedFS S3, anonymous read only (writes require the
# signed credentials only the app holds). Object keys contain UUIDs.
files.{$DOMAIN} {
	reverse_proxy seaweedfs:8333
}

# The marketing site. Kept on its own hostname so the app keeps the origin its
# auth callbacks and stored object URLs were issued against.
home.{$DOMAIN} {
	reverse_proxy landing:3001
}
