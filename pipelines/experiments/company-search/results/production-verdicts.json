{
  "experiment": "production-replay: the learning shortlist on real fit-check verdicts",
  "question": "When a check answers what production's fit check really said, does the learning shortlist still find more companies per check than today's ranking?",
  "design": {
    "code": "src/distribution/shortlist.ts (fillShortlist) and src/distribution/learn.ts (createShortlistLearner), as production runs them",
    "pool": "brreg-breweries: every company judged once by production's fit check (src/distribution/judge.ts, unchanged), English brief, \"Norway\" as the place",
    "judge": "gemini-3.8-flash-fast: the fast route of apps/web/config/chat-models.yaml through OpenRouter. A deployment whose chat routes point at another model may judge differently; none was called",
    "check": "one check answers the recorded verdict on that company and costs 1; the loop and the learner see nothing else",
    "counted": {
      "judged": "a company is good when the fit check said yes",
      "register": "a company is good by its register code, as in E4"
    },
    "stability": "200 companies were asked about a second time in other batches; `changed` is how many verdicts differ",
    "candidates": "a seed's 80% draw of the pool, in today's order",
    "laterRun": "the pool is split in two at random. A first run fills its shortlist on one half with the learner and keeps its verdicts; a second run meets the other half three ways: today's ranking, the learner starting from nothing (`fresh`), and the learner starting from the kept verdicts (`seeded`)",
    "embeddingModels": {
      "nomic-embed-text": "nomic-embed-text (local, the benchmark's model)",
      "gemini-embedding-001@768": "gemini-embedding-001 at 768 dimensions (index gemini-embedding-768, the one the registry recommends)",
      "text-embedding-3-large@1536": "text-embedding-3-large at 1536 dimensions (index legacy-openai-1536, the default)"
    },
    "intervals": "95% percentile bootstrap over the seeds of this one pool: they say how stable the figure is on this pool, not how far it carries to another"
  },
