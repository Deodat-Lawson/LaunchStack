# Development files
*.test.ts
*.spec.ts
__tests__
.github
.vscode

# Eval-runner scripts that require __tests__ helpers (excluded above).
# They never run at deploy time, but next build's type-check compiles
# scripts/, so uploading them without __tests__ fails every deployment.
apps/web/scripts/run-founder-weekly-review-*.ts

# Sidecar (ML deps too large for Vercel — Adeu runs via api/adeu/ instead)
sidecar/

# Large static files not needed in serverless
public/vad/*.js.map
public/vad/*.wasm.map

# Documentation
*.md
!README.md

# Build artifacts
.next/cache
.turbo

# Vercel CLI default-ignores ".pnp*" (Yarn PnP), which wrongly matches .pnpmfile.cjs — re-include it
!.pnpmfile.cjs
