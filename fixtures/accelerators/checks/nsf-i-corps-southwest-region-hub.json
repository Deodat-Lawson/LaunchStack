    },
    {
      "id": "check-page-29efde3334",
      "url": "https://swicorps.org/faqs/",
      "page": "terms",
      "excerpt": "The Technical Lead will typically be a faculty member, senior research scientist, or postdoctoral scholar with technical expertise in the team’s technology."
    },
