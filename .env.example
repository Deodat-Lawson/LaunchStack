# ═══════════════════════════════════════════════════════════════════════
# Launchstack — Environment Variables
#
# Schema lives at apps/web/src/env.ts. Keep this file in sync with it.
# ═══════════════════════════════════════════════════════════════════════

# ── Core (required) ──────────────────────────────────────────────────

# Matches what `make up-prod` publishes: Compose maps Postgres to host port
# 5433 with database pdr_ai_v2. If you run your own Postgres instead, the
# commented line below is the conventional default.
DATABASE_URL="postgresql://postgres:password@localhost:5433/pdr_ai_v2"
# DATABASE_URL="postgresql://user:password@localhost:5432/pdr_ai"

# ── Deployment shape ─────────────────────────────────────────────────

# "self-hosted" (default when unset) or "cloud".
#
# Self-hosted is the default on purpose: it is the mode where getting this
# wrong is unrecoverable for the person affected. Under "cloud" the token
# ledger gates uploads on a balance, and nothing in the product can add
# credits — so a self-hosted instance in that mode stops accepting documents
# for good once its signup grant runs out. Self-hosted still records usage
# (visible at /api/credits/usage), it just never refuses work.
#
# Cloud also enables Vercel Analytics and makes INNGEST_EVENT_KEY mandatory.
# DEPLOYMENT_MODE="self-hosted"

# ── Public URLs ──────────────────────────────────────────────────────

# Origin the public site (apps/landing) is served from. Local: http://localhost:3001
# NEXT_PUBLIC_SITE_URL="https://launchstack.app"
# Origin the app (apps/web) is served from — where the landing site's sign-in
# and sign-up buttons point. Local: http://localhost:3000
# NEXT_PUBLIC_APP_URL="https://app.launchstack.app"

# ── Support channels (shown on the in-app contact page) ──────────────

# Unset means the contact form is hidden and users are pointed at the project's
# issue tracker instead of a form that goes nowhere.
# SUPPORT_CONTACT_EMAIL=""
# SUPPORT_COMMUNITY_URL=""
# SUPPORT_RESPONSE_TIME="Within 1 business day"
# SUPPORT_ISSUES_URL="https://github.com/Deodat-Lawson/LaunchStack/issues"

# Extra hostnames next/image may load from, comma-separated. Any *.ufs.sh
# (UploadThing) and your S3 endpoint are allowed automatically. Build-time:
# next/image validates against the compiled list, so changing this needs a
# rebuild.
# IMAGE_REMOTE_PATTERNS=""

# Override the pdf.js worker URL. Left unset the worker is served from this
# instance (copied into public/ at build time), which is what an air-gapped
# deployment needs. Also build-time — a NEXT_PUBLIC_ value is inlined into the
# bundle, so a prebuilt image cannot be pointed elsewhere.
# NEXT_PUBLIC_PDF_WORKER_URL=""

# Optional. Used ONLY by `pnpm db:migrate` / `db:verify` / drizzle-kit.
# Must be a DIRECT (session) connection — the migration runner takes a
# session-level advisory lock so concurrent deploys cannot race, and that lock
# does not survive a transaction-mode pooler (pgbouncer, Supabase :6543, Neon
# pooled endpoints). Leave unset to reuse DATABASE_URL.
# MIGRATE_DATABASE_URL="postgresql://user:password@localhost:5432/pdr_ai"

# Auth (better-auth, first-party). Signs session cookies and reset tokens.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=BETTER_AUTH_SECRET
# Public origin, e.g. https://app.example.com — optional in dev, set it in
# any deployment behind a proxy so callbacks resolve to the outside hostname.
# BETTER_AUTH_URL=""
# Optional social sign-in; auth is credentials-only without these.
# AUTH_GOOGLE_CLIENT_ID=""
# AUTH_GOOGLE_CLIENT_SECRET=""
# AUTH_GITHUB_CLIENT_ID=""
# AUTH_GITHUB_CLIENT_SECRET="

# ── Chat ─────────────────────────────────────────────────────────────
#
# Chat reaches exactly ONE endpoint that implements the OpenAI
# chat-completions protocol. That endpoint may serve many models; which model
# handles which kind of work lives in apps/web/config/chat-models.yaml, not
# here. Nothing is inferred from a model id.
#
# See docs/chat-models.md for the full reference.

# Google Gemini is the default. Leaving CHAT_BASE_URL unset reaches the same
# endpoint — set GOOGLE_AI_API_KEY instead of CHAT_API_KEY in that case. Get a
# key at https://aistudio.google.com/apikey
CHAT_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
CHAT_API_KEY="AIza..."

# Other endpoints (pick one). Each also needs its models named in
# apps/web/config/chat-models.yaml — the shipped file lists Gemini ids.
# CHAT_BASE_URL="https://openrouter.ai/api/v1"       + CHAT_API_KEY="sk-or-v1-..."
# CHAT_BASE_URL="https://api.openai.com/v1"          + CHAT_API_KEY="sk-..."
# CHAT_BASE_URL="https://api.minimax.io/v1"          + CHAT_API_KEY="..."
# CHAT_BASE_URL="http://localhost:11434/v1"          # Ollama; leave CHAT_API_KEY unset
# CHAT_BASE_URL="http://localhost:8080/v1"           # llama.cpp / vLLM / LM Studio
#
# Leave CHAT_API_KEY unset for a keyless local endpoint. A placeholder is sent
# so the OpenAI SDK cannot fall back to an unrelated OPENAI_API_KEY.

# Alternate model configuration file. Defaults to config/chat-models.yaml.
# CHAT_MODELS_CONFIG="config/chat-models.production.yaml"

# ── Supporting AI capabilities (embeddings, OCR, rerank, NER, TTS) ────
#
# Independent from chat: these never borrow CHAT_API_KEY, and chat never
# borrows theirs.
#
# Option A — one global provider for supporting AI capabilities:
#   AI_BASE_URL + AI_API_KEY routes embeddings, reranking, NER, and
#   transcription through a single OpenAI-compatible API.
#
# Option B — configure each supporting capability independently:
#   Set per-capability env vars (EMBEDDING_API_*, RERANK_API_*, etc.)
#
# Resolution order: per-capability → global fallback → legacy key → Gemini.
#
# The default endpoint is Gemini's OpenAI-compatible surface, the same one
# chat falls back to — every capability, with no per-vendor exceptions.
# Reranking and transcription needed special handling to get there: Google
# serves neither /rerank nor /audio/transcriptions, so reranking scores
# relevance on a chat model and transcription passes audio into chat
# completions. Both are reachable at any OpenAI-compatible endpoint.
#
# A credential on its own still does not say where to send the request. The
# base URL and the key are read as a PAIR at every level, so OPENAI_API_KEY is
# used only alongside a URL that names OpenAI — it is never forwarded to the
# Gemini default. Pair it with AI_BASE_URL, or the capability's own
# *_API_BASE_URL.

# Credential for the default Gemini endpoint (embeddings, OCR/VLM, NER).
# GOOGLE_AI_API_KEY="AIza..."

# Global AI provider (optional — overrides the Gemini default when set)
# AI_BASE_URL="https://api.example.com/v1"
# AI_API_KEY="..."

# Model for supporting capabilities when the endpoint above is OpenAI's.
# OPENAI_MODEL="gpt-5-mini"

# Which embedding index (model + dimension + storage) documents are written
# to. UNCHANGED by the Gemini default: embedding vectors are persisted, so
# switching model invalidates every stored vector and requires a full
# re-index. See docs/chat-models.md.
EMBEDDING_INDEX="legacy-openai-1536"

# 32 random bytes, base64-encoded — encrypts per-company embedding provider
# API keys at rest. Generate once and keep constant across deploys:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EMBEDDING_SECRETS_KEY=

# Inert — model selection moved to apps/web/config/chat-models.yaml. Setting
# this only produces a startup warning.
# GOOGLE_MODEL=""

# Hugging Face embeddings (optional)
# HUGGINGFACE_API_KEY=
# HUGGINGFACE_EMBEDDING_MODEL=
# HUGGINGFACE_EMBEDDING_DIMENSION=
# HUGGINGFACE_EMBEDDING_VERSION="v1"

# Ollama legacy model and embedding settings (optional)
# OLLAMA_MODEL="llama3.1:8b"
# OLLAMA_EMBEDDING_MODEL=
# OLLAMA_EMBEDDING_DIMENSION=
# OLLAMA_EMBEDDING_VERSION="v1"

# ── Per-Capability Overrides (optional) ──────────────────────────────

# Embeddings — model defaults to OpenAI text-embedding-3-large and, unlike
# every other capability, does NOT fall back to Gemini. Vectors are persisted:
# changing the model invalidates the whole corpus, so the endpoint must be
# named explicitly and a switch has to be paired with a re-index.
# For a NEW deployment, point these at Gemini and set
# EMBEDDING_INDEX="gemini-embedding-768" above — that index is registered and
# ready. Existing corpora must stay on legacy-openai-1536 until re-indexed.
# EMBEDDING_API_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
# EMBEDDING_API_KEY="AIza..."
# EMBEDDING_MODEL="gemini-embedding-001"

# Reranking — defaults to scoring relevance on gemini-2.5-flash-lite, because
# Google serves no /rerank endpoint. Setting RERANK_API_BASE_URL switches to a
# dedicated /v1/rerank service instead, which is faster and cheaper per query;
# RERANK_MODEL is then required, since such a service names its own model.
# RERANK_API_BASE_URL="https://api.example.com/v1"
# RERANK_API_KEY="..."
# RERANK_MODEL="bge-reranker-v2-m3"

# NER (entity extraction) — defaults to gemini-2.5-flash-lite on the Gemini
# endpoint. Set NER_API_BASE_URL (or AI_BASE_URL above) to route it elsewhere;
# NER_MODEL must then name a model that endpoint serves.
# NER_API_BASE_URL="https://api.example.com/v1"
# NER_API_KEY="..."
# NER_MODEL="gemini-2.5-flash-lite"

# Transcription — defaults to gemini-2.5-flash on the Gemini endpoint. There is
# no /audio/transcriptions endpoint on Google's compatibility layer, so audio is
# passed into chat completions as an input_audio part. Uploads must be wav, mp3,
# aiff, aac, ogg or flac; the browser converts its WebM recording to WAV first.
# TRANSCRIPTION_API_BASE_URL="https://api.example.com/v1"
# TRANSCRIPTION_API_KEY="..."
# TRANSCRIPTION_MODEL="gemini-2.5-flash"
# "sidecar" routes uploads to the self-hosted services/transcription
# deployment (TRANSCRIPTION_SERVICE_URL below) instead of the cloud model.
# TRANSCRIPTION_PROVIDER="cloud"  # "cloud" | "sidecar"

# Speech generation (text-to-speech) — Google Cloud Text-to-Speech,
# authenticated with the same GOOGLE_AI_API_KEY above. No service account is
# needed, but that key's project must have the Cloud Text-to-Speech API
# enabled. Google's OpenAI-compatibility layer has no /audio/speech route, so
# this is the one capability reached outside it. Output is MP3.
#
# Voices are Chirp 3: HD, named <locale>-Chirp3-HD-<voice>, and are GA. The
# locale is derived from the voice name. The gemini-2.5-flash-tts voices are
# also GA and support natural-language style direction, but require the
# aiplatform.endpoints.predict IAM permission — i.e. a service account.
# GEMINI_TTS_VOICE="en-US-Chirp3-HD-Kore"

# ── Compute Services (ADR-004) ───────────────────────────────────────
# The old `sidecar` container was split into services/transcription and
# services/adeu-ai-docs-editing. Its phantom inference endpoints (embed / rerank /
# extract-entities) were removed outright — no service ever implemented them —
# so there is no SIDECAR_EMBEDDING_* configuration anymore.
#
# Legacy names: SIDECAR_URL / SIDECAR_API_KEY are still read as deprecated
# fallbacks for TRANSCRIPTION_SERVICE_URL / TRANSCRIPTION_SERVICE_API_KEY
# (with a startup warning), and DOCUMENT_EDITOR_URL / DOCUMENT_EDITOR_API_KEY
# for ADEU_SERVICE_URL / ADEU_SERVICE_API_KEY (ADR-007's service rename).

# Whisper transcription + yt-dlp download (services/transcription).
# Docker:   http://transcription:8000
# Local:    http://localhost:8000
# TRANSCRIPTION_SERVICE_URL="http://localhost:8000"
# Shared secret sent as X-API-Key. The service's auth fails closed: if this is
# unset on either side, or the two copies differ, every call returns 401. Set
# the same value in the service's own environment (TRANSCRIPTION_API_KEY).
# TRANSCRIPTION_SERVICE_API_KEY="pdr_local_sidecar_key"

# ── Agent Knowledge Connector (optional) ─────────────────────────────
# Imports the knowledge Claude Code and Codex already keep on disk
# (CLAUDE.md / AGENTS.md, subagents, slash commands, skills, memories,
# prompts) into the workspace knowledge base. It reads the filesystem of the
# machine running the web app, so leave it off on shared hosts — there the
# server's disk is not the user's disk. Credential files and session
# transcripts are never read; see packages/features/src/connectors/README.md.

# AGENT_KNOWLEDGE_CONNECTOR_ENABLED="true"
# Project directories the connector may scan, separated by the platform path
# delimiter (":" on macOS/Linux, ";" on Windows). Global ~/.claude and
# ~/.codex are always in scope when the connector is enabled.
# AGENT_KNOWLEDGE_PROJECT_ROOTS="/Users/me/code/launchstack:/Users/me/code/other"

# ── Workspace connections (optional) ─────────────────────────────────
# Lets a workspace admin connect Google Drive, Slack, or GitHub to their
# workspace (Add source → Connect). Connections are per-workspace: the OAuth
# grant is stored encrypted (EMBEDDING_SECRETS_KEY is required) against the
# company, attributed to the member who granted it. With no client pair set,
# that provider's Connect button shows "not configured" and nothing changes.
#
# Each pair comes from an OAuth app you register with the provider. The
# redirect URI for Slack and GitHub is
#   <APP_PUBLIC_URL>/api/connectors/<provider>/oauth/callback
# (google's is /api/connectors/google/oauth/callback — see below).
#
# Google Drive — files/folders picked in the Google Picker sync into the
# knowledge base every 15 minutes. Uses the SAME GCP OAuth client as
# Drive-Linked Files: set GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET
# in that block further down (GOOGLE_DOCS_EDITING_ENABLED is NOT required for
# the knowledge sync — the pair alone enables connecting). On top of that
# setup, also enable the "Google Picker API" and create:
# Browser API key for the Google Picker (safe to expose; restrict it to the
# Picker API in the Cloud console).
# NEXT_PUBLIC_GOOGLE_API_KEY="AIza..."
# The Cloud project NUMBER (not id) — required for the Picker to register
# drive.file grants to this app.
# NEXT_PUBLIC_GOOGLE_APP_ID="1234567890"
#
# Slack — installs your Slack app's bot into one Slack workspace per
# connection; the collab meeting mirror prefers this over the global
# SLACK_BOT_TOKEN below. Create an app at api.slack.com/apps with bot scopes
# chat:write, channels:read, channels:manage, channels:history, users:read,
# and add the redirect URI above under OAuth & Permissions.
# SLACK_CLIENT_ID="1234567890.1234567890"
# SLACK_CLIENT_SECRET="..."
#
# GitHub — a user-authorized token stored for the workspace; the repo
# explainer and GitHub repo upload use it for private repos, falling back to
# the global GITHUB_TOKEN. Register an OAuth app under
# github.com/settings/developers with the callback URL above. Note the `repo`
# scope is read-write by GitHub's design (OAuth apps have no read-only repo
# scope); a GitHub App installation is the finer-grained upgrade path.
# GITHUB_OAUTH_CLIENT_ID="Iv1...."
# GITHUB_OAUTH_CLIENT_SECRET="..."

# ── Document Processing — OCR ────────────────────────────────────────

# Paid cloud providers (optional)
# AZURE_DOC_INTELLIGENCE_ENDPOINT="https://..."
# AZURE_DOC_INTELLIGENCE_KEY="..."
# LANDING_AI_API_KEY="..."
# DATALAB_API_KEY="..."

# Self-hosted document converter (services/document-converter, ADR-004) —
# consolidated OCR routing, vision classification, PDF page rendering, and
# Docling parsing. Replaces the removed ocr-router/ocr-worker services:
# OCR_ROUTER_URL is still read as a deprecated fallback for the URL;
# OCR_WORKER_URL is ignored.
# DOCUMENT_CONVERTER_URL="http://localhost:8002"
# Shared secret sent as X-API-Key on every converter call. The converter's
# auth fails closed and this value deliberately has NO legacy fallback: leave
# it unset and every routing/parsing call returns 401 rather than running
# unauthenticated. Set the same value as CONVERTER_API_KEY in the converter's
# own environment.
# DOCUMENT_CONVERTER_API_KEY="pdr_local_converter_key"
# The converter only fetches documents from origins listed in its own
# ALLOWED_FETCH_ORIGINS env var (SSRF allow-list) — include this app's origin
# (APP_PUBLIC_URL) and your S3 endpoint there. See services/document-converter.
# OCR_DEFAULT_PROVIDER="DOCLING"   # DOCLING | NATIVE_PDF | AZURE | LANDING_AI | DATALAB
# OCR_VISION_MODEL="gemini-2.5-flash"
# Publicly-reachable origin of this app — required when the converter needs to
# fetch /api/files/ URLs from outside the Next.js process.
# APP_PUBLIC_URL="http://app:3000"
# REQUIRED for database-backed storage. Signs the short-lived token appended
# to /api/files/ URLs: that route requires a session, and no server-side
# reader has one — not the document converter, and not the app's own OCR,
# page-count, vision-enrichment or archive-expansion fetches. Uploads that
# resolve to an internal file reference fail closed with 503 until it is set.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# FILE_ACCESS_TOKEN_SECRET=""
# REQUIRED in production. Bearer token for Prometheus scrapes of
# GET /api/metrics; the endpoint returns 503 (and logs once) while it is unset,
# so an upgrade that skips it silently blanks existing dashboards. Locally,
# leaving it unset allows unauthenticated scrapes for convenience.
# METRICS_SCRAPE_TOKEN=""
# REQUIRED to send email campaigns. HMAC key for the unsubscribe links in
# outgoing mail; issuing or verifying one throws without it, and it must be at
# least 16 characters. Rotating it invalidates every unsubscribe link in mail
# already delivered. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# EMAIL_UNSUBSCRIBE_SECRET=""
# Set to "true" to let campaign sends actually deliver. Anything else (including
# unset) runs them as a dry run — recipients are resolved and recorded, but no
# mail leaves the machine.
# EMAIL_SENDING_ENABLED=""

# NOTE: a block here used to document FILE_ACCESS_HMAC_KEY and
# METRICS_BEARER_TOKEN, and pointed at apps/web/src/server/security/. Neither
# variable has ever been read anywhere in the repo and that directory holds
# only url-guard.ts, so setting them bought nothing while reading as though two
# endpoints had been secured. The real variables are FILE_ACCESS_TOKEN_SECRET
# and METRICS_SCRAPE_TOKEN, documented directly above.

# ── DOCX Redlining (services/adeu-ai-docs-editing) ──────────────────
# The authoritative Word-editing service (ADR-007): tracked changes, review
# items, accept/reject, CriticMarkup preview, diffing. Backs the in-app Word
# editor at /employer/documents.
# Docker:   http://adeu-docs-editing:8000
# Local:    http://localhost:8003
ADEU_SERVICE_URL="http://localhost:8003"
# Shared secret sent as X-API-Key; fails closed like the other services. Set
# the same value in the service's own environment (ADEU_SERVICE_API_KEY).
# ADEU_SERVICE_API_KEY="pdr_local_adeu_key"
#
# Set on the SERVICE (not the app): origins it may fetch documents from when a
# request passes an object reference instead of uploading the file. Unset means
# object references are disabled and every document must be uploaded inline —
# arbitrary URLs are never accepted (ADR-004 §6).
# ADEU_ALLOWED_FETCH_ORIGINS="http://app:3000,http://seaweedfs:8333"
#
# Deprecated (ADR-007), still read as fallbacks:
# DOCUMENT_EDITOR_URL="http://localhost:8003"
# DOCUMENT_EDITOR_API_KEY="pdr_local_sidecar_key"

# ── Drive-Linked Files (optional) ───────────────────────────────────
# Link PDFs and Word documents to Google Drive so they can be edited manually
# (Google Docs for Word files; any Drive app or Drive for Desktop for PDFs).
# Settled Drive revisions sync back as immutable document versions and
# re-index. Dark until the flag AND the OAuth client are both set.
#
# GCP setup (the one lead-time item): create a project, enable the Drive API,
# configure the OAuth consent screen, and create a Web-application OAuth
# client whose redirect URI is <APP_PUBLIC_URL>/api/connectors/google/oauth/callback.
# Only the non-restricted drive.file scope is used — the app can touch files
# it created, nothing else in anyone's Drive.
# GOOGLE_DOCS_EDITING_ENABLED="true"
# GOOGLE_OAUTH_CLIENT_ID="1234567890-abc.apps.googleusercontent.com"
# GOOGLE_OAUTH_CLIENT_SECRET="GOCSPX-..."
# Optional explicit override; defaults to APP_PUBLIC_URL + the callback path.
# GOOGLE_OAUTH_REDIRECT_URL="https://app.example.com/api/connectors/google/oauth/callback"
# Quiet period before the reconciler pulls a Drive revision (default 10):
# Docs autosaves per keystroke; a settled revision becomes one version.
# GOOGLE_DOCS_SETTLE_MINUTES="10"

# ── Web Search (optional) ───────────────────────────────────────────

# SEARCH_PROVIDER="exa"  # exa | serper | fallback | parallel
# EXA_API_KEY="..."
# SERPER_API_KEY="..."

# ── Client Prospector (optional) ────────────────────────────────────

# FOURSQUARE_SERVICE_KEY=""

# ── Repo Explainer (optional) ───────────────────────────────────────

# GITHUB_TOKEN=""

# ── Marketing Pipeline (optional) ───────────────────────────────────

# REDDIT_CLIENT_ID=""
# REDDIT_CLIENT_SECRET=""
# REDDIT_USER_AGENT=""
# TWITTER_BEARER_TOKEN=""
# LINKEDIN_ACCESS_TOKEN=""
# BLUESKY_HANDLE=""
# BLUESKY_APP_PASSWORD=""

# ── LangSmith Tracing (optional) ────────────────────────────────────

# LANGCHAIN_TRACING_V2="false"
# LANGCHAIN_API_KEY="..."
# LANGCHAIN_PROJECT="launchstack"

# ── File Upload (optional) ──────────────────────────────────────────

NEXT_PUBLIC_UPLOADTHING_ENABLED="true"
# UPLOADTHING_TOKEN="..."
# BLOB_READ_WRITE_TOKEN="..."

# ── Background Jobs ─────────────────────────────────────────────────

# Inngest backs the background verticals: trend search, client prospector,
# founder weekly review, predictive analysis, website crawl, document modify,
# reindex. Document INGESTION does not use it — that runs through the Postgres
# transactional outbox in apps/worker (ADR-003) — so an instance without
# Inngest still ingests and answers questions, it just cannot run those seven.
#
# Required when DEPLOYMENT_MODE=cloud; otherwise a missing key logs a warning
# at boot and the verticals stay off. The Compose stack sets INNGEST_DEV and
# runs a dev server, which ignores the key entirely.
INNGEST_EVENT_KEY="local"
# INNGEST_SIGNING_KEY="signkey-dev-xxxxx"

# ── Graph RAG (optional) ────────────────────────────────────────────

# ENABLE_GRAPH_RETRIEVER="false"
# NEO4J_URI=""
# NEO4J_USERNAME=""
# NEO4J_PASSWORD=""

# ── File Storage ────────────────────────────────────────────────────
# "s3" → any S3-compatible endpoint (AWS, MinIO, SeaweedFS)
# "database" → base64 in Postgres (no-S3 fallback)
# Unset → auto-detect based on S3 vars

# NEXT_PUBLIC_STORAGE_PROVIDER="s3"
# NEXT_PUBLIC_S3_ENDPOINT="http://localhost:8333"
# S3_PUBLIC_ENDPOINT=""   # Browser-facing S3 URL (defaults to NEXT_PUBLIC_S3_ENDPOINT)
# S3_REGION="us-east-1"
# S3_ACCESS_KEY="pdr_local_key"
# S3_SECRET_KEY="pdr_local_secret"
# S3_BUCKET_NAME="pdr-documents"

# ── Token System ─────────────────────────────────────────────────────

# Free tokens granted to each new company on signup (default: 10,000,000)
# TOKEN_SIGNUP_BONUS="10000000"

# ── CORS ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for API CORS headers.
# CORS_ALLOWED_ORIGINS="https://yourdomain.com,https://app.yourdomain.com"

# ── Logging ──────────────────────────────────────────────────────────
# fatal | error | warn | info | debug | trace (default: info in prod, debug in dev)
# LOG_LEVEL="info"

# ── Meetings, Slack, and distributed agents ──────────────────────────
# Meetings run as conversations in a channel. Agents take turns, a human can
# take the floor at any point, and the channel can be mirrored to Slack.
#
# COLLAB_HUB_SECRET turns on remote agent nodes: a worker on another machine
# signs every request with it. Leave unset and every agent runs in this
# process — which is the right default until you actually need a second host.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# COLLAB_HUB_SECRET=""
# COLLAB_HUB_ID="launchstack-hub"

# Slack. The bot token posts meeting turns into a channel; the signing secret
# verifies inbound Events API deliveries so people can steer a meeting from
# Slack. Either half works on its own — token alone gives a read-only mirror.
# Point your Slack app's Event Subscriptions URL at
#   https://<your app>/api/collab/slack/events
# and subscribe to message.channels (message.groups for private channels).
# SLACK_BOT_TOKEN="xoxb-…"
# SLACK_SIGNING_SECRET=""
# SLACK_WEBHOOK_URL=""   # legacy: predictive-analysis alerts only
