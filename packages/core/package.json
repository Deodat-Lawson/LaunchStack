  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ./scripts/fix-esm-specifiers.mjs",
    "clean": "rm -rf dist .tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check && node ./scripts/check-journal.mjs",
    "db:migrate": "node ./scripts/migrate.mjs",
    "db:verify": "node ./scripts/migrate.mjs --check",
    "db:baseline": "node ./scripts/migrate.mjs --baseline",
    "db:seed": "node ./scripts/seed.mjs",
    "db:studio": "drizzle-kit studio"
