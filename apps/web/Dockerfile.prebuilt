# syntax=docker/dockerfile:1
#
# Fast Docker image that skips the Next.js build — you run `pnpm --filter @launchstack/web build`
# on the host first, then this just copies the output into a slim image.
#
# Usage:
#   SKIP_ENV_VALIDATION=1 STANDALONE_BUILD=1 pnpm --filter @launchstack/web build
#   docker compose -f docker-compose.yml -f docker-compose.prebuilt.yml build app migrate
#   docker compose -f docker-compose.yml -f docker-compose.prebuilt.yml up -d

# ── Base: shared Alpine + corepack-managed pnpm ──────────────────────
FROM node:20-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@10.15.1 --activate
WORKDIR /app

# ── Dependencies (workspace-aware) ───────────────────────────────────
FROM base AS deps
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml .pnpmfile.cjs ./
COPY patches ./patches/
COPY packages/core/package.json ./packages/core/
COPY packages/features/package.json ./packages/features/
COPY apps/web/package.json ./apps/web/
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile

# ── Schema sync (migrate) ────────────────────────────────────────────
# Same forward migration command as every other environment. See the notes on
# this stage in apps/web/Dockerfile.
FROM deps AS migrate
COPY packages/core/drizzle ./packages/core/drizzle
COPY packages/core/scripts ./packages/core/scripts
COPY apps/web/drizzle ./apps/web/drizzle

WORKDIR /app/packages/core
# Engine set first, then product: product migrations carry foreign keys into
# engine tables, so the order is load-bearing, not cosmetic.
CMD ["sh", "-c", "node scripts/migrate.mjs && node scripts/migrate.mjs --set=product"]

# ── Runner (uses pre-built .next from host) ──────────────────────────
# Reads the host's build output rather than rebuilding in Docker. The
# Next.js standalone layout for a pnpm workspace lives at
# apps/web/.next/standalone/ and contains apps/web/server.js + a pruned
# node_modules tree.
FROM node:20-alpine AS runner
WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

COPY --chown=nextjs:nodejs apps/web/.next/standalone ./
COPY --chown=nextjs:nodejs apps/web/.next/static ./apps/web/.next/static
COPY --chown=nextjs:nodejs apps/web/public ./apps/web/public
# Read at runtime, not bundled by the standalone build — see apps/web/Dockerfile.
COPY --chown=nextjs:nodejs apps/web/config ./apps/web/config

USER nextjs

# Start where server.js lives, so the relative CHAT_MODELS_CONFIG default
# resolves against the config copied above — see apps/web/Dockerfile.
WORKDIR /app/apps/web

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["node", "server.js"]
