{
    "name": "@launchstack/engine",
    "version": "0.2.0",
    "description": "The one-install aggregate: createEngine() assembles the LaunchStack feature packages (store, llm, conversion, indexing, search, orchestration) behind a single CoreConfig, and re-exports their surfaces for consumers who want one dependency instead of eight.",
    "license": "Apache-2.0",
    "type": "module",
    "sideEffects": false,
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./config": "./src/config/index.ts",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "public",
        "main": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "./config": {
                "types": "./dist/config/index.d.ts",
                "default": "./dist/config/index.js"
            },
            "./package.json": "./package.json"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json && node ./scripts/fix-esm-specifiers.mjs",
        "clean": "rm -rf dist .tsbuildinfo",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@launchstack/runtime": "workspace:^",
        "@launchstack/store": "workspace:^",
        "@launchstack/llm": "workspace:^",
        "@launchstack/conversion": "workspace:^",
        "@launchstack/indexing": "workspace:^",
        "@launchstack/retrieval": "workspace:^",
        "@launchstack/orchestration": "workspace:^",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "typescript": "^5.9.2",
        "vitest": "^3.0.5"
    }
}
