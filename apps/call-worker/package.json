{
  "name": "@launchstack/call-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/main.js --external:@zoom/rtms",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "test": "tsx --test 'src/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@launchstack/core": "workspace:*",
    "@launchstack/features": "workspace:*",
    "@zoom/rtms": "1.1.0",
    "drizzle-orm": "^0.45.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "esbuild": "^0.25.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
