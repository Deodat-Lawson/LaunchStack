{
  "name": "@launchstack/tools",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared, contract-typed capabilities composed by the feature verticals. Tools are imported, never deployed: capabilities move down into this package, pipelines stay up in @launchstack/features.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./contract": {
      "types": "./src/contract.ts",
      "default": "./src/contract.ts"
    },
    "./company-context": {
      "types": "./src/company-context/index.ts",
      "default": "./src/company-context/index.ts"
    },
    "./company-context/schema": {
      "types": "./src/company-context/schema.ts",
      "default": "./src/company-context/schema.ts"
    },
    "./grounded-retrieval": {
      "types": "./src/grounded-retrieval/index.ts",
      "default": "./src/grounded-retrieval/index.ts"
    },
    "./brand-voice": {
      "types": "./src/brand-voice/index.ts",
      "default": "./src/brand-voice/index.ts"
    },
    "./persona": {
      "types": "./src/persona/index.ts",
      "default": "./src/persona/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@langchain/core": "^0.3.74",
    "@launchstack/core": "workspace:*",
    "drizzle-orm": "^0.45.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.0.5"
  }
}
