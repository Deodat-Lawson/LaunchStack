{
  "name": "@launchstack/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Launchstack Next.js application \u2014 hosts the engine (via @launchstack/core) and all vertical features behind Clerk auth.",
  "license": "Apache-2.0",
  "scripts": {
    "build": "next build",
    "check": "eslint . && tsc --noEmit",
    "db:migrate": "pnpm --filter @launchstack/core db:migrate && node ../../packages/core/scripts/migrate.mjs --set=product",
    "db:verify": "pnpm --filter @launchstack/core db:verify && node ../../packages/core/scripts/migrate.mjs --set=product --check",
    "db:generate": "drizzle-kit generate",
    "db:backfill": "tsx ./scripts/backfill.ts",
    "db:push:danger": "node ../../packages/core/scripts/guard-push.mjs",
    "db:studio": "pnpm --filter @launchstack/core db:studio",
    "collab:hub": "tsx ./scripts/collab-hub.ts",
    "collab:worker": "tsx ./scripts/collab-worker.ts",
    "evals:meetings": "tsx --tsconfig ./tsconfig.json ./scripts/run-meeting-evals.ts",
    "dev": "concurrently --names next,inngest --prefix-colors blue,magenta \"next dev --turbo\" \"pnpm dlx inngest-cli@latest dev -u http://localhost:3000/api/inngest\"",
    "dev:next": "next dev --turbo",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "preview": "next build && next start",
    "start": "next start",
    "test": "jest --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "inngest:dev": "pnpm dlx inngest-cli@latest dev -u http://localhost:3000/api/inngest"
  },
