{
    "name": "@launchstack/runtime",
    "version": "0.2.0",
    "description": "What a LaunchStack host process wires in: the clock and logger ports, the actor/workspace context shape, the typed error taxonomy, the storage and job-dispatcher slots, and the HMR-safe singleton slot every configure*/get* pair is built on. Depends on nothing.",
    "license": "Apache-2.0",
    "type": "module",
    "sideEffects": false,
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./errors": "./src/errors.ts",
        "./storage": "./src/storage-port/index.ts",
        "./jobs": "./src/job-dispatcher-port/index.ts",
        "./slot": "./src/singleton-slot.ts",
        "./wire-version": "./src/wire-version.ts",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "public",
        "main": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "./errors": {
                "types": "./dist/errors.d.ts",
                "default": "./dist/errors.js"
            },
            "./storage": {
                "types": "./dist/storage-port/index.d.ts",
                "default": "./dist/storage-port/index.js"
            },
            "./jobs": {
                "types": "./dist/job-dispatcher-port/index.d.ts",
                "default": "./dist/job-dispatcher-port/index.js"
            },
            "./slot": {
                "types": "./dist/singleton-slot.d.ts",
                "default": "./dist/singleton-slot.js"
            },
            "./wire-version": {
                "types": "./dist/wire-version.d.ts",
                "default": "./dist/wire-version.js"
            },
            "./package.json": "./package.json"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json && node ./scripts/fix-esm-specifiers.mjs",
        "clean": "rm -rf dist .tsbuildinfo",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run"
    },
    "dependencies": {},
    "devDependencies": {
        "typescript": "^5.9.2",
        "vitest": "^3.0.5"
    }
}
