# Optional settings for pnpm test:tl. No manual copy is required.
# First run generates a random password in ignored vantage-tl.env.local.
# To choose your own password, copy this file to vantage-tl.env.local before
# first run and fill in 16-128 letters, digits, underscores or hyphens.
# Keep that local file for subsequent runs against the persistent test volume.
VANTAGE_TL_TEST_PASSWORD=

# Host 127.0.0.1, port 55434, database vantage_tl_contract_v1 and user vantage_tl
# are fixed by the test contract. The launcher injects all database URL settings.
# This file does not configure the app, authentication or model credentials.
