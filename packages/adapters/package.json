{
    "name": "@launchstack/adapters",
    "version": "0.0.0",
    "description": "Implementations of the Launchstack application ports and the engine subsystems behind @launchstack/core's facade: Postgres repositories (including the transactional outbox), the Drizzle schema, ingestion/OCR/RAG/LLM/embeddings implementations, object-storage access, and HTTP clients for the compute services. Configuration is injected \u2014 nothing here reads process.env (ADR-002, ADR-003).",
    "license": "Apache-2.0",
    "type": "module",
    "sideEffects": false,
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./ingestion/doc-ingestion": "./src/ingestion/doc-ingestion/index.ts",
        "./package.json": "./package.json",
        "./*": "./src/*.ts"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "public",
        "main": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "./ingestion/doc-ingestion": {
                "types": "./dist/ingestion/doc-ingestion/index.d.ts",
                "default": "./dist/ingestion/doc-ingestion/index.js"
            },
            "./package.json": "./package.json",
            "./*": {
                "types": "./dist/*.d.ts",
                "default": "./dist/*.js"
            }
        }
    },
    "dependencies": {},
    "peerDependencies": {
        "@langchain/community": "^0.3.54",
        "langchain": "^0.3.33",
        "neo4j-driver": "^6.0.0",
        "tesseract.js": "^7.0.0"
    },
    "peerDependenciesMeta": {
        "@langchain/community": {
            "optional": true
        },
        "langchain": {
            "optional": true
        },
        "neo4j-driver": {
            "optional": true
        },
        "tesseract.js": {
            "optional": true
        }
    },
    "private": true
}
