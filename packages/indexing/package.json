{
    "name": "@launchstack/indexing",
    "version": "0.2.0",
    "description": "Takes conversion's output and makes it searchable: heading-aligned and code-aware chunking, embedding generation under named indexes with reindex state, entity extraction, knowledge-graph sync into Neo4j, the OCR pipeline body, and the two-stage doc-ingestion pipeline the worker drives.",
    "license": "Apache-2.0",
    "type": "module",
    "sideEffects": false,
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./knowledge-graph": "./src/knowledge-graph/index.ts",
        "./entity-extraction": "./src/entity-extraction.ts",
        "./doc-ingestion": "./src/doc-ingestion/index.ts",
        "./pipeline-port": "./src/pipeline-port.ts",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "public",
        "main": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "./knowledge-graph": {
                "types": "./dist/knowledge-graph/index.d.ts",
                "default": "./dist/knowledge-graph/index.js"
            },
            "./entity-extraction": {
                "types": "./dist/entity-extraction.d.ts",
                "default": "./dist/entity-extraction.js"
            },
            "./doc-ingestion": {
                "types": "./dist/doc-ingestion/index.d.ts",
                "default": "./dist/doc-ingestion/index.js"
            },
            "./pipeline-port": {
                "types": "./dist/pipeline-port.d.ts",
                "default": "./dist/pipeline-port.js"
            },
            "./package.json": "./package.json"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json && node ./scripts/fix-esm-specifiers.mjs",
        "clean": "rm -rf dist .tsbuildinfo",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@launchstack/runtime": "workspace:^",
        "@launchstack/store": "workspace:^",
        "@launchstack/llm": "workspace:^",
        "@launchstack/conversion": "workspace:^",
        "@launchstack/orchestration": "workspace:^",
        "drizzle-orm": "^0.45.1",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "typescript": "^5.9.2",
        "vitest": "^3.0.5"
    },
    "peerDependencies": {
        "neo4j-driver": "^6.0.0"
    },
    "peerDependenciesMeta": {
        "neo4j-driver": {
            "optional": true
        }
    }
}
