{
    "name": "@launchstack/simulation",
    "version": "0.1.0",
    "description": "A social-network simulation in rounds: model-driven agents read a ranked feed, post, comment, like, repost and follow, and can be interviewed afterwards. A TypeScript port of the OASIS design (CAMEL-AI, Apache-2.0). Zero dependencies; the host injects the model.",
    "license": "Apache-2.0",
    "type": "module",
    "sideEffects": false,
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "NOTICE"
    ],
    "publishConfig": {
        "access": "public",
        "main": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "./package.json": "./package.json"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json && node ./scripts/fix-esm-specifiers.mjs",
        "clean": "rm -rf dist .tsbuildinfo",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run"
    },
    "dependencies": {},
    "devDependencies": {
        "typescript": "^5.9.2",
        "vitest": "^3.0.5"
    }
}
