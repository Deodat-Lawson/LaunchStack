{
  "experiment": "production-replay: the shortlist learns from each verdict",
  "question": "Does production's own ranking code find more good companies per fit check than today's fixed ranking, on E4's pools?",
  "design": {
    "code": "src/distribution/shortlist.ts (fillShortlist) and src/distribution/learn.ts (createShortlistLearner), as production runs them",
    "pools": "E4's seven reported segments, each with a brief in its companies' own language (E4's headline condition)",
    "check": "one check reveals one company's hidden label (directory tag or register code) and costs 1",
    "candidates": "a seed's 80% draw of the pool, in today's order: relevance, ties in the draw's order",
    "arms": {
      "today": "the fixed ranking through production's loop: 2 companies per open shortlist place each round",
      "today-in-rounds": "the fixed ranking asked 10 at a time, so the effect of the round size alone is visible",
      "learner": "production's learner picks every round of 10"
    },
    "metrics": {
      "found": "good companies among the first 25, 50, 100, 200 checks, with no shortlist to fill",
      "checksTo25": "checks until the 25th good company was checked, capped at 500",
      "spent": "checks production's loop makes before a 25-place shortlist is full, in whole rounds",
      "rounds": "rounds of that run. The fit check makes one model call per twenty companies of a round: three for today's first round of fifty, one for a round of ten"
    },
    "learner": {
      "dims": 48,
      "noiseSd": 0.5,
      "priorSdScore": 0.25,
      "priorSdBias": 1,
      "priorSdProjection": 0.4,
      "bonus": 0.5,
      "rounds": 6
    },
    "embeddingModels": {
      "nomic-embed-text": "nomic-embed-text (local, the benchmark's model)",
      "gemini-embedding-001@768": "gemini-embedding-001 at 768 dimensions (index gemini-embedding-768, the one the registry recommends)",
      "text-embedding-3-large@1536": "text-embedding-3-large at 1536 dimensions (index legacy-openai-1536, the default)"
    },
    "intervals": "95% percentile bootstrap, 2,000 resamples: over pools and then seeds, as in E4"
  },
