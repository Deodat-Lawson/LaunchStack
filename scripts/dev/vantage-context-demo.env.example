# Documentation only. The demo launcher does not load dotenv files.
# Default --serve needs no provider credentials and uses clearly labeled replay.
# Optional live mode: export these values into the current process, then use --serve-live.
CHAT_BASE_URL=https://YOUR-APPROVED-RESOURCE.openai.azure.com/openai/v1/
CHAT_API_KEY=
# Optional absolute override; default is tracked apps/web/config/chat-models.vantage-demo.azure.yaml
# CHAT_MODELS_CONFIG=ABSOLUTE-PATH-TO-THE-APPROVED-YAML
# Optional clean-clone verification target; never changes the default demo resources.
# VANTAGE_CONTEXT_DEMO_DB_PORT=55438
# VANTAGE_CONTEXT_DEMO_APP_PORT=3105
